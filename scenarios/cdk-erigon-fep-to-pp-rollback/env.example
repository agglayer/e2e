# Copy to .env to override. Every value has a working default.

# Kurtosis enclave name. Must be unique on the host.
ENCLAVE_NAME=fep-to-pp-rollback
# kurtosis-cdk git ref (full commit SHA). Default: contents of assets/kurtosis-cdk.ref
#KURTOSIS_CDK_REF=
# Kurtosis args file describing the Silicon-like validium (versions documented inside).
KURTOSIS_PARAMS=assets/kurtosis-params.yml

# What Polygon upgrades the agglayer to (the image that disabled interop_sendTx). Mainnet: 0.6.0 GA.
AGGLAYER_IMAGE_AFTER=ghcr.io/agglayer/agglayer:0.6.0
# What the chain operator upgrades cdk-erigon to. Runbook minimum is v2.61.24.
CDK_ERIGON_IMAGE_AFTER=hermeznetwork/cdk-erigon:v2.61.24
# Aggkit image from the runbook.
AGGKIT_IMAGE=ghcr.io/agglayer/aggkit:0.8.1

# How many batches must be verified through the legacy path before we break settlement.
MIN_VERIFIED_BATCHES_BEFORE_BREAK=3
# How many sequenced-but-unverified batches to accumulate before rolling back (Silicon had 118).
MIN_UNVERIFIED_GAP=4

# Keep the enclave running at the end (for inspection / screenshots). Default tears it down.
KEEP_ENCLAVE=false
# Re-use an existing enclave instead of deploying (debugging aid; pair with START_STEP).
REUSE_ENCLAVE=false
# First step to execute when resuming (0 = full run).
START_STEP=0
# Where to write evidence (command outputs, logs). Default: evidence/run-<timestamp>/
#EVIDENCE_DIR=
